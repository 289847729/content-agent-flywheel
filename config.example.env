# 飞书多维表格（选题库）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# 微信公众号（草稿箱推送）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选：草稿作者名，默认「小崽子AI」
WECHAT_AUTHOR=小崽子AI

# 文案生成 LLM（任意 OpenAI 兼容服务，如 Antigravity 代理 / DeepSeek / OpenAI）
LLM_API_BASE=http://localhost:8045/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4

# 公众号封面全自动生图（可选；服务和凭据留空时复用 LLM 配置）
IMAGE_GEN_API_BASE=
IMAGE_GEN_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_COVER_MODEL=gemini-3.1-flash-image
# 优先请求横版素材，最终自动裁切为公众号 900×383 封面
IMAGE_COVER_SIZE=1536x1024
IMAGE_WECHAT_COVER_SIZE=1536x1024

# 多平台封面会根据平台自动请求合适比例；服务不支持时自动请求方图后裁切
IMAGE_XHS_COVER_SIZE=1024x1536
IMAGE_JRTT_COVER_SIZE=1536x864
